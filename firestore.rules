// CinemaHub Firestore Security Rules
// Only approved users can access app data and private subcollections.
// Admins and owners can manage users, access requests, and providers.
// Users CANNOT set or modify their own status/role fields.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner'
      );
    }

    function isApproved() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    // Catalogue cache — approved users can read; backend/admin only writes
    match /catalogue/{contentId} {
      allow read: if isApproved();
      allow write: if false;
    }

    // User profile document — user can read/create/update non-protected fields;
    // admins/owners can read and write all fields including status/role.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['status', 'role']);

      allow update: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role']);

      allow write: if isAdmin();
    }

    // User profiles — approved owner (or admin) only
    match /users/{userId}/profiles/{profileId} {
      allow read, write: if isApproved() && (request.auth.uid == userId || isAdmin());
    }

    // Watch history — approved owner (or admin) only
    match /users/{userId}/watchHistory/{contentId} {
      allow read, write: if isApproved() && (request.auth.uid == userId || isAdmin());
    }

    // Watchlist — approved owner (or admin) only
    match /users/{userId}/watchlist/{contentId} {
      allow read, write: if isApproved() && (request.auth.uid == userId || isAdmin());
    }

    // Access requests — user can only create/read their own pending request; admins manage status
    match /accessRequests/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'pending');
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Provider registry — approved users can read; admins manage
    match /providers/{providerId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();

      match /health/{healthId} {
        allow read: if isApproved();
        allow write: if isAdmin();
      }
    }

    // Legacy provider health collection — approved users can read; admins write
    match /providerHealth/{providerId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Admin dashboard docs — owners and admins only
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin user status management — triggers onUserStatusUpdate Cloud Function
    match /admin/userStatus/users/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
